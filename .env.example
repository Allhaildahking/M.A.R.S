MARS_ENV=development
MARS_LOG_LEVEL=INFO
MARS_DATABASE_URL=sqlite:///data/mars.db

# Server-side API authentication. Replace this placeholder with a long random secret.
MARS_API_TOKEN=replace-with-a-long-random-secret

# Gemini provider credentials. Leave blank for tests that do not call the live provider.
GEMINI_API_KEY=
MARS_GEMINI_MODEL=gemini-3.8-flash
